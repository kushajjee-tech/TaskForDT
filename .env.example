# ---- Mode -----------------------------------------------------------
# sample = run on bundled QuickBooks-shaped sample data (no credentials needed)
# live   = pull from your QuickBooks sandbox companies
SOURCE_MODE=sample

# ---- QuickBooks app (Development / sandbox keys) ---------------------
QBO_CLIENT_ID=
QBO_CLIENT_SECRET=
QBO_ENVIRONMENT=sandbox

# One realm + refresh token per company (get both from the OAuth 2.0 Playground)
QBO_US_REALM_ID=
QBO_US_REFRESH_TOKEN=
QBO_UK_REALM_ID=
QBO_UK_REFRESH_TOKEN=

# ---- Sync settings ---------------------------------------------------
BACKFILL_START=2025-01-01
LOOKBACK_MONTHS=3

# ---- AI chart-of-accounts mapper ---------------------------------------
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
AUTO_APPROVE_CONFIDENCE=0.97   # calibrated with make eval, see README
